{
	"extends": "../../tsconfig.json",
	"compilerOptions": {
		"types": ["bun"],
		"jsx": "react-jsx",
		"jsxImportSource": "hono/jsx",
		"baseUrl": ".",
		"paths": {
			"@api/*": ["./src/*"],
			"@modules/*": ["./src/modules/*"],
			"@modules": ["./src/modules"]
